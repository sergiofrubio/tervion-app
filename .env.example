# ==============================================================================
# Tervion ERP — Configuración de Entorno (Open Source & Self-Hosted)
# ==============================================================================

# Entorno de la aplicación (development | production | testing)
APP_ENV=production
APP_URL=http://localhost

# Configuración de Base de Datos (MySQL / MariaDB)
DB_HOST=db
DB_NAME=app
DB_USER=root
DB_PASS=root

# Configuración del Servidor de Correo (SMTP)
# En desarrollo local con Docker Compose, se utiliza Mailpit (puerto 1025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_AUTO_TLS=false
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=noreply@tervion.local
MAIL_FROM_NAME="Tervion ERP"

# Integración Opcional: Meta Cloud API para WhatsApp (Avisos de citas a pacientes)
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Integración Opcional: Pasarela Redsys (Cobro de bonos de pacientes en portal clínico)
REDSYS_API_KEY=

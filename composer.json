{
    "name": "sergiofrubio/tervion-app",
    "description": "tervion APP",
    "license": "MIT",
    "type": "library",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Redsys\\": "vendor/redsys-lib/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "Tests/"
        }
    },
    "require": {
        "php": ">=8.0",
        "phpmailer/phpmailer": "^6.9",
        "fpdf/fpdf": "^1.86"
    },
    "require-dev": {
        "phpunit/phpunit": "13",
        "phpdocumentor/shim": "^3.10"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "phpdocumentor/shim": true
        }
    }
}
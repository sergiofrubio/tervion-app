{
  "name": "tervion-app-frontend",
  "version": "1.0.0",
  "description": "Frontend build tools for Tervion ERP using Tailwind CSS and Sass",
  "license": "LGPL-3.0-or-later",
  "main": "index.js",
  "scripts": {
    "build:sass": "sass public/scss/app.scss public/css/app.tmp.css",
    "build:tailwind": "tailwindcss -i public/css/app.tmp.css -o public/css/app.css --minify",
    "build": "npm run build:sass && npm run build:tailwind",
    "watch:sass": "sass --watch public/scss/app.scss public/css/app.tmp.css",
    "watch:tailwind": "tailwindcss -i public/css/app.tmp.css -o public/css/app.css --watch",
    "dev": "npm run build && npm run watch:tailwind"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "sass": "^1.71.1",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "tinymce": "^6.8.3"
  }
}